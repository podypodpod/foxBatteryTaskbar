<Project>
  <!-- Settings shared by every project in the repo -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Enforce code style rules (e.g. unused usings) at build time, not just in the IDE -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) to run in the build; we don't require XML docs on everything -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Version>0.1.1</Version>
    <Authors>podypodpod</Authors>
    <Copyright>Copyright (c) 2026 podypodpod</Copyright>
    <RepositoryUrl>https://github.com/podypodpod/foxBatteryTaskbar</RepositoryUrl>
  </PropertyGroup>
</Project>
